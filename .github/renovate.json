{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "baseBranches": [
        "v3.0"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "automergeType": "branch",
            "automergeStrategy": "rebase"
        },
        {
            "matchUpdateTypes": [
                "major",
                "minor"
            ],
            "enabled": false,
            "matchPackageNames": [
                "/^org.robolectric:android-all/"
            ]
        },
        {
            "matchCurrentValue": "/-SNAPSHOT$/",
            "enabled": false,
            "matchPackageNames": [
                "/^org.tinylog:/"
            ]
        }
    ]
}
